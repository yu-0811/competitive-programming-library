# gen.py、naive.py、main.py と同じディレクトリに置く。
# そのディレクトリで `bash stress` を実行する。

set -e
while true; do
    pypy3 gen.py > in.txt
    c=$(pypy3 naive.py < in.txt)
    w=$(pypy3 main.py < in.txt)
    if [[ $c == "$w" ]]; then echo pass; continue; fi
    echo "WA"
    # printf 'o:\n%s\nx:\n%s\n' "$c" "$w" # 期待と実際を出力したかったら
    exit 1
done
